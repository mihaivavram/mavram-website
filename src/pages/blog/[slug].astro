---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import AuthorBox from '../../components/AuthorBox.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/blog';
import { formatPostDate, isoDate, readingTimeMinutes } from '../../lib/posts';
import { SITE_URL, canonicalUrl, pageTitle } from '../../lib/site';
import { blogPostingJsonLd, serializeJsonLd } from '../../lib/structured-data';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = post.data;
const url = canonicalUrl(`/blog/${post.id}`);

// Link previews (LinkedIn, Slack, X) get the cover as a JPEG; posts without one use the site image.
const coverPreview = cover ? await getImage({ src: cover, width: 1200, format: 'jpg' }) : undefined;
const image = coverPreview
  ? {
      url: new URL(coverPreview.src, SITE_URL).href,
      alt: coverAlt ?? title,
      width: Number(coverPreview.attributes.width),
      height: Number(coverPreview.attributes.height),
    }
  : undefined;

const jsonLd = blogPostingJsonLd({
  title,
  description,
  url,
  datePublished: pubDate,
  dateModified: updatedDate,
  imageUrl: image?.url,
  tags,
});
---

<BaseLayout
  title={pageTitle(title)}
  description={description}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate }}
  image={image}
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={serializeJsonLd(jsonLd)}
  ></script>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={isoDate(pubDate)}>{formatPostDate(pubDate)}</time> ·{' '}
        {readingTimeMinutes(post.body ?? '')} min read
        {updatedDate && (
          <Fragment>
            {' '}
            · Updated <time datetime={isoDate(updatedDate)}>{formatPostDate(updatedDate)}</time>
          </Fragment>
        )}
      </p>
    </header>
    {cover && (
      <Image class="post-cover" src={cover} alt={coverAlt ?? ''} width={1200} loading="eager" />
    )}
    <div class="prose">
      <Content />
    </div>
    {tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}
    <AuthorBox />
  </article>
  <p class="back">
    <a href="/blog">← All posts</a>
  </p>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    margin-bottom: 0.5rem;
  }

  .post-cover {
    width: 100%;
    height: auto;
    margin-bottom: 2rem;
    border-radius: var(--radius);
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
