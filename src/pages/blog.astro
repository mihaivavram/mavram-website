---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, toIsoDate } from '../lib/format';
import { pageTitle } from '../lib/site';

const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={pageTitle('Blog')}
  description="Posts by Mihai Avram about startups, software development and machine learning."
>
  <h1>Recent Posts</h1>
  <ul class="list">
    {posts.map(({ data }) => (
      <li>
        <a class="item-title external" href={data.url} target="_blank" rel="noopener noreferrer">
          {data.title}
        </a>
        <p class="meta">
          <time datetime={toIsoDate(data.date)}>{formatDate(data.date)}</time>
        </p>
        <p class="tags">{data.tags.join(' · ')}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
