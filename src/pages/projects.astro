---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle } from '../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  projects.map(async (project) => ({ project, Content: (await render(project)).Content })),
);
const groups = [
  {
    heading: 'Current Projects',
    items: rendered.filter(({ project }) => project.data.group === 'current'),
  },
  {
    heading: 'Past Projects',
    items: rendered.filter(({ project }) => project.data.group === 'past'),
  },
];
---

<BaseLayout
  title={pageTitle('Projects')}
  description="Current and past projects by Mihai Avram, including LACRM QuickSync, Cingo Research, Elebase and Fakey."
>
  <h1>Projects</h1>
  {groups.map(({ heading, items }) => (
    <section>
      <h2>{heading}</h2>
      <ul class="list">
        {items.map(({ project: { data }, Content }) => (
          <li class="project">
            <div class="logo">
              <Image src={data.logo} alt={data.alt} width={56} densities={[1, 2]} />
            </div>
            <div>
              <h3>{data.title}</h3>
              {data.links.length > 0 && (
                <p class="links">
                  {data.links.map((link) => (
                    <a class="external" href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))}
                </p>
              )}
              <div class="description">
                <Content />
              </div>
              {data.tags.length > 0 && <p class="tags">{data.tags.join(' · ')}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .project {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1.25rem;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0.375rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #ffffff;
  }

  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0.125rem 0 0.5rem;
    font-size: 0.9375rem;
  }

  .description :global(p) {
    margin: 0;
  }

  .description :global(p + p) {
    margin-top: 0.75rem;
  }
</style>
