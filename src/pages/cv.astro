---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle } from '../lib/site';

const resume = '/cv/MihaiAvram_CV.pdf';
---

<BaseLayout title={pageTitle('CV')}>
  <h1>Resume</h1>
  <p>
    <a href={resume} target="_blank" rel="noopener noreferrer">
      Download As PDF
    </a>
  </p>
  <iframe title="My Resume" src={resume} width="100%" height="1000"></iframe>
</BaseLayout>
