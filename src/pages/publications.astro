---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicationLinkLabel } from '../lib/format';
import { pageTitle } from '../lib/site';

const publications = (await getCollection('publications')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={pageTitle('Publications')}>
  <h1>Publications</h1>
  <ul class="list">
    {publications.map(({ data }) => (
      <li>
        <h2 class="publication-title">{data.title}</h2>
        <p class="meta">{data.authors}</p>
        <p class="meta venue">{data.venue}</p>
        <p class="meta">
          <a class="external" href={data.url} target="_blank" rel="noopener noreferrer">
            {publicationLinkLabel(data.url)}
          </a>
        </p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .publication-title {
    margin: 0 0 0.25rem;
    font-size: 1.0625rem;
    letter-spacing: normal;
  }

  .venue {
    font-style: italic;
  }
</style>
