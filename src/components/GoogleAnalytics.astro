---
// Google's gtag.js snippet, unchanged apart from reading the measurement ID from one place.
// is:inline keeps Astro from bundling it, so gtag() stays a global function.
import { GA_MEASUREMENT_ID } from '../lib/analytics';

const config = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());

gtag('config', '${GA_MEASUREMENT_ID}');`;
---

<!-- Google tag (gtag.js) -->
<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
></script>
<script is:inline set:html={config}></script>
