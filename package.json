  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
