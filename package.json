{
  "name": "mavram-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A repository for my website.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "npm run check && npm run spell",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run format:check && npm run lint && npm run test:unit && npm run test:e2e",
    "spell": "cspell --no-progress --no-summary \"src/content/**\" \"src/pages/**\"",
    "links": "lychee --root-dir \"$PWD/dist\" \"dist/**/*.html\"",
    "og-image": "node scripts/generate-og-image.mjs",
    "new-post": "node scripts/new-post.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihaivavram/mavram-website.git"
  },
  "keywords": [
    "personal",
    "website"
  ],
  "author": "Mihai Avram",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mihaivavram/mavram-website/issues"
  },
  "homepage": "https://mihaisplace.com",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "cspell": "^10.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
